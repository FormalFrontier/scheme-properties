module

import Mathlib.Algebra.Field.Rat
import Mathlib.Algebra.MvPolynomial.Division
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Proper
import Mathlib.RingTheory.Ideal.Maximal
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.Topology.Connected.Basic
import Mathlib.Topology.KrullDimension
import SchemeProperties.ProjectiveSpectrum
import SchemeProperties.Rigidity

/-!
# Rigidity for the projective-line family

The proper integral source is the total-degree projective spectrum of
`ℚ[T₀,T₁]`, with its coefficient-defined structure map to `Spec ℚ` and the
rational section given by evaluation at `(1,0)`. A strict specialization from
the zero homogeneous prime to the prime generated by `T₁` witnesses positive
topological Krull dimension.

Its product with the affine line carries the second projection. At the generic
point of the affine line, the projection's fibre has singleton image. The
unique factor through the affine line is its identity. The private model and
its direct uniqueness proof are independent of rigidity; the final theorem
also obtains this factorization from the relative rigidity theorem.

## References

The grading, projective spectrum, proper structure morphism and map from global
sections are Mathlib's constructions. Scheme Properties supplies the projective
spectrum criteria and the relative rigidity theorem.
-/

noncomputable section

open CategoryTheory MvPolynomial AlgebraicGeometry

namespace SchemePropertiesTest.RigidityProjectiveLine

attribute [local instance] MvPolynomial.gradedAlgebra

private abbrev coordinateRing := MvPolynomial (Fin 2) ℚ

private abbrev projectiveLine : Scheme :=
  Proj (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ)

private abbrev rationalBase : Scheme := Spec (CommRingCat.of ℚ)

private theorem coordinateRing_isDomain : IsDomain coordinateRing := inferInstance

private theorem coordinateRing_isReduced : _root_.IsReduced coordinateRing := inferInstance

private theorem xZero_mem_irrelevant :
    X (0 : Fin 2) ∈
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) :=
  HomogeneousIdeal.mem_irrelevant_of_mem _ Nat.zero_lt_one (MvPolynomial.isHomogeneous_X ℚ _)

private theorem zeroHomogeneousIdeal_isPrime :
    (⊥ : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ)).toIdeal.IsPrime := by
  rw [HomogeneousIdeal.toIdeal_bot]
  exact Ideal.isPrime_bot

private theorem zeroHomogeneousIdeal_relevant :
    ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) ≤ ⊥ := by
  intro h
  have hx : X (0 : Fin 2) ∈ (⊥ : Ideal coordinateRing) := h xZero_mem_irrelevant
  exact MvPolynomial.X_ne_zero _ (Ideal.mem_bot.mp hx)

private def genericPoint :
    ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) where
  asHomogeneousIdeal := ⊥
  isPrime := zeroHomogeneousIdeal_isPrime
  not_irrelevant_le := zeroHomogeneousIdeal_relevant

private theorem projectiveLine_nonempty : Nonempty projectiveLine := ⟨genericPoint⟩

private theorem projectiveLine_isReduced : AlgebraicGeometry.IsReduced projectiveLine := by
  let : _root_.IsReduced coordinateRing := coordinateRing_isReduced
  exact AlgebraicGeometry.Proj.isReduced (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ)

private theorem projectiveLine_preirreducibleSpace : PreirreducibleSpace projectiveLine := by
  let : IsDomain coordinateRing := coordinateRing_isDomain
  exact AlgebraicGeometry.Proj.preirreducibleSpace
    (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ)

private theorem projectiveLine_isIntegral : AlgebraicGeometry.IsIntegral projectiveLine := by
  let : IsDomain coordinateRing := coordinateRing_isDomain
  let : Nonempty projectiveLine := projectiveLine_nonempty
  exact AlgebraicGeometry.Proj.isIntegral (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ)

private theorem gradeZeroSubalgebra_eq_bot :
    SetLike.GradeZero.subalgebra (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) =
      (⊥ : Subalgebra ℚ coordinateRing) := by
  apply Subalgebra.toSubmodule_injective
  change MvPolynomial.homogeneousSubmodule (Fin 2) ℚ 0 =
    (⊥ : Subalgebra ℚ coordinateRing).toSubmodule
  rw [MvPolynomial.homogeneousSubmodule_zero, Algebra.toSubmodule_bot]

private def coefficientEquiv :
    ℚ ≃ₐ[ℚ] MvPolynomial.homogeneousSubmodule (Fin 2) ℚ 0 :=
  ((Subalgebra.equivOfEq
      (SetLike.GradeZero.subalgebra (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ))
      (⊥ : Subalgebra ℚ coordinateRing) gradeZeroSubalgebra_eq_bot).trans
    (Algebra.botEquivOfInjective (R := ℚ) (A := coordinateRing) (by
      simpa only [MvPolynomial.algebraMap_eq] using
        (MvPolynomial.C_injective (Fin 2) ℚ)))).symm

private def coefficientMap :
    ℚ →+* MvPolynomial.homogeneousSubmodule (Fin 2) ℚ 0 := algebraMap _ _

private theorem coefficientEquiv_toRingHom : coefficientEquiv.toRingHom = coefficientMap := by
  exact Subsingleton.elim _ _

private theorem coefficientMap_inclusion (q : ℚ) :
    algebraMap (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ 0) coordinateRing
      (coefficientMap q) = MvPolynomial.C q := rfl

private theorem coefficientScalarTower :
    IsScalarTower ℚ (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ 0) coordinateRing :=
  IsScalarTower.of_algebraMap_eq (R := ℚ)
    (S := MvPolynomial.homogeneousSubmodule (Fin 2) ℚ 0) (A := coordinateRing)
    fun _ => rfl

private theorem coordinateRing_finiteType_gradeZero :
    Algebra.FiniteType (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ 0) coordinateRing := by
  let := coefficientScalarTower
  exact Algebra.FiniteType.of_restrictScalars_finiteType ℚ
    (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ 0) coordinateRing

private def coefficientSpecMap :
    Spec (CommRingCat.of (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ 0)) ⟶ rationalBase :=
  Spec.map (CommRingCat.ofHom coefficientMap)

private theorem coefficientMap_isIso : IsIso (CommRingCat.ofHom coefficientMap) := by
  rw [← coefficientEquiv_toRingHom]
  exact coefficientEquiv.toRingEquiv.toCommRingCatIso.isIso_hom

private theorem coefficientSpecMap_isIso : IsIso coefficientSpecMap := by
  let := coefficientMap_isIso
  exact inferInstanceAs (IsIso (Spec.map (CommRingCat.ofHom coefficientMap)))

private def structureMap : projectiveLine ⟶ rationalBase :=
  Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) ≫ coefficientSpecMap

private theorem structureMap_isProper : IsProper structureMap := by
  let := coordinateRing_finiteType_gradeZero
  let := coefficientSpecMap_isIso
  exact inferInstanceAs (IsProper
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) ≫ coefficientSpecMap))

private def coordinateEvaluation : coordinateRing →+* ℚ :=
  MvPolynomial.eval (fun i : Fin 2 => if i = 0 then 1 else 0)

private theorem coordinateEvaluation_xZero : coordinateEvaluation (X (0 : Fin 2)) = 1 := by
  simp [coordinateEvaluation]

private theorem coordinateEvaluation_xOne : coordinateEvaluation (X (1 : Fin 2)) = 0 := by
  simp [coordinateEvaluation]

private def sectionCoordinates : coordinateRing →+* Γ(rationalBase, ⊤) :=
  (Scheme.ΓSpecIso (CommRingCat.of ℚ)).inv.hom.comp coordinateEvaluation

private theorem sectionCoordinates_irrelevant_map :
    (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ)).toIdeal.map
      sectionCoordinates = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  have hx := Ideal.mem_map_of_mem sectionCoordinates xZero_mem_irrelevant
  simpa only [sectionCoordinates, RingHom.comp_apply, coordinateEvaluation_xZero, map_one] using hx

private def rationalSection : rationalBase ⟶ projectiveLine :=
  Proj.fromOfGlobalSections (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ)
    sectionCoordinates sectionCoordinates_irrelevant_map

private theorem rationalSection_preimage_xZero :
    rationalSection ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ)
      (X (0 : Fin 2)) = ⊤ := by
  rw [rationalSection, Proj.fromOfGlobalSections_preimage_basicOpen _ _ _ Nat.zero_lt_one
    (MvPolynomial.isHomogeneous_X ℚ (0 : Fin 2))]
  simp only [sectionCoordinates, RingHom.comp_apply, coordinateEvaluation_xZero, map_one,
    Scheme.basicOpen_one]

private theorem rationalSection_preimage_xOne :
    rationalSection ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ)
      (X (1 : Fin 2)) = ⊥ := by
  rw [rationalSection, Proj.fromOfGlobalSections_preimage_basicOpen _ _ _ Nat.zero_lt_one
    (MvPolynomial.isHomogeneous_X ℚ (1 : Fin 2))]
  simp only [sectionCoordinates, RingHom.comp_apply, coordinateEvaluation_xOne, map_zero,
    Scheme.basicOpen_zero]

private theorem sectionCoordinates_coefficients :
    (sectionCoordinates.comp
      (algebraMap (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ 0) coordinateRing)).comp
      coefficientMap = (Scheme.ΓSpecIso (CommRingCat.of ℚ)).inv.hom := by
  ext q
  change (Scheme.ΓSpecIso (CommRingCat.of ℚ)).inv.hom
      (coordinateEvaluation
        (algebraMap (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ 0) coordinateRing
          (coefficientMap q))) = _
  rw [coefficientMap_inclusion]
  simp only [coordinateEvaluation, MvPolynomial.eval_C]

private theorem rationalSection_structureMap : rationalSection ≫ structureMap = 𝟙 rationalBase := by
  dsimp only [structureMap, rationalSection, coefficientSpecMap]
  rw [← Category.assoc, Proj.fromOfGlobalSections_toSpecZero, Category.assoc,
    ← Spec.map_comp, ← CommRingCat.ofHom_comp, sectionCoordinates_coefficients]
  exact toSpecΓ_SpecMap_ΓSpecIso_inv (CommRingCat.of ℚ)

private def coordinateIdeal :
    HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) :=
  ⟨Ideal.span {X (1 : Fin 2)}, Ideal.homogeneous_span _ _ (by
    intro f hf
    rcases Set.mem_singleton_iff.mp hf with rfl
    exact ⟨1, MvPolynomial.isHomogeneous_X ℚ (1 : Fin 2)⟩)⟩

private theorem xZero_not_mem_coordinateIdeal : X (0 : Fin 2) ∉ coordinateIdeal := by
  change X (0 : Fin 2) ∉ Ideal.span {X (1 : Fin 2)}
  rw [Ideal.mem_span_singleton, MvPolynomial.X_dvd_X]
  decide

private theorem xOne_mem_coordinateIdeal : X (1 : Fin 2) ∈ coordinateIdeal :=
  Ideal.mem_span_singleton_self _

private theorem coordinateIdeal_isPrime : coordinateIdeal.toIdeal.IsPrime :=
  Ideal.isPrime_span_singleton_of_prime (MvPolynomial.X_prime (R := ℚ) (i := (1 : Fin 2)))

private def coordinatePoint :
    ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) where
  asHomogeneousIdeal := coordinateIdeal
  isPrime := coordinateIdeal_isPrime
  not_irrelevant_le := fun h => xZero_not_mem_coordinateIdeal (h xZero_mem_irrelevant)

private theorem genericPoint_le_coordinatePoint : genericPoint ≤ coordinatePoint :=
  (ProjectiveSpectrum.as_ideal_le_as_ideal _ _ _).mp bot_le

private theorem coordinatePoint_not_le_genericPoint : ¬ coordinatePoint ≤ genericPoint := by
  intro h
  have hx : X (1 : Fin 2) ∈ (⊥ : Ideal coordinateRing) := h xOne_mem_coordinateIdeal
  exact MvPolynomial.X_ne_zero _ (Ideal.mem_bot.mp hx)

private theorem genericPoint_lt_coordinatePoint : genericPoint < coordinatePoint :=
  lt_of_le_not_ge genericPoint_le_coordinatePoint coordinatePoint_not_le_genericPoint

private def genericClosure : TopologicalSpace.IrreducibleCloseds projectiveLine where
  carrier := closure ({genericPoint} : Set projectiveLine)
  isIrreducible' := isIrreducible_singleton.closure
  isClosed' := isClosed_closure

private def coordinateClosure : TopologicalSpace.IrreducibleCloseds projectiveLine where
  carrier := closure ({coordinatePoint} : Set projectiveLine)
  isIrreducible' := isIrreducible_singleton.closure
  isClosed' := isClosed_closure

private theorem coordinateClosure_lt_genericClosure : coordinateClosure < genericClosure := by
  refine lt_of_le_not_ge ?_ ?_
  · change closure ({coordinatePoint} : Set projectiveLine) ⊆
      closure ({genericPoint} : Set projectiveLine)
    apply closure_minimal ?_ isClosed_closure
    exact Set.singleton_subset_iff.mpr
      ((ProjectiveSpectrum.le_iff_mem_closure
        (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) genericPoint coordinatePoint).mp
          genericPoint_le_coordinatePoint)
  · intro h
    have hη : genericPoint ∈ closure ({coordinatePoint} : Set projectiveLine) :=
      h (subset_closure (Set.mem_singleton genericPoint))
    exact coordinatePoint_not_le_genericPoint
      ((ProjectiveSpectrum.le_iff_mem_closure
        (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) coordinatePoint genericPoint).mpr hη)

private theorem projectiveLine_positiveDimension : 0 < topologicalKrullDim projectiveLine := by
  change 0 < Order.krullDim (TopologicalSpace.IrreducibleCloseds projectiveLine)
  exact Order.krullDim_pos_iff.mpr
    ⟨coordinateClosure, genericClosure, coordinateClosure_lt_genericClosure⟩

private abbrev affineLine : Scheme := Spec (CommRingCat.of (Polynomial ℚ))

private def parameterMap : affineLine ⟶ rationalBase :=
  Spec.map (CommRingCat.ofHom (Polynomial.C : ℚ →+* Polynomial ℚ))

private theorem affineLine_preconnected : PreconnectedSpace affineLine := by infer_instance

private theorem parameterMap_isSeparated : IsSeparated parameterMap := by
  exact inferInstanceAs
    (IsSeparated (Spec.map (CommRingCat.ofHom (Polynomial.C : ℚ →+* Polynomial ℚ))))

private def parameterGenericPoint : affineLine := ⟨⊥, Ideal.isPrime_bot⟩

private abbrev family : Scheme := Limits.pullback structureMap parameterMap

private def projection : family ⟶ affineLine := Limits.pullback.snd structureMap parameterMap

private def parameterSection : affineLine ⟶ family :=
  Limits.pullback.lift (parameterMap ≫ rationalSection) (𝟙 affineLine) (by
    simp only [Category.assoc, rationalSection_structureMap, Category.comp_id, Category.id_comp])

private theorem parameterSection_projection : parameterSection ≫ projection = 𝟙 affineLine :=
  Limits.pullback.lift_snd _ _ _

private def familyMap : family ⟶ affineLine := projection

private theorem familyMap_over : familyMap ≫ parameterMap = projection ≫ parameterMap := rfl

private theorem familyMap_collapsedFibre :
    Set.Subsingleton
      (familyMap '' (projection ⁻¹' ({parameterGenericPoint} : Set affineLine))) := by
  rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
  simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx hy
  exact hx.trans hy.symm

private theorem familyMap_factorization : familyMap = projection ≫ 𝟙 affineLine := by
  simp only [Category.comp_id, familyMap]

private theorem familyMap_unique_factor :
    ∃! g : affineLine ⟶ affineLine,
      g ≫ parameterMap = parameterMap ∧ familyMap = projection ≫ g := by
  refine ⟨𝟙 affineLine, ⟨Category.id_comp _, familyMap_factorization⟩, ?_⟩
  intro g hg
  calc
    g = parameterSection ≫ (projection ≫ g) := by
      rw [← Category.assoc, parameterSection_projection, Category.id_comp]
    _ = parameterSection ≫ familyMap := by rw [hg.2]
    _ = 𝟙 affineLine := parameterSection_projection

private theorem familyMap_unique_factor_via_rigidity :
    ∃! g : affineLine ⟶ affineLine,
      g ≫ parameterMap = parameterMap ∧ familyMap = projection ≫ g := by
  let : IsProper structureMap := structureMap_isProper
  let : AlgebraicGeometry.IsIntegral projectiveLine := projectiveLine_isIntegral
  let : PreconnectedSpace affineLine := affineLine_preconnected
  let : IsSeparated parameterMap := parameterMap_isSeparated
  exact AlgebraicGeometry.Scheme.Hom.existsUnique_factor_through_snd_of_subsingleton_fiber_image
    ℚ projectiveLine affineLine affineLine structureMap parameterMap parameterMap
    rationalSection rationalSection_structureMap familyMap familyMap_over
    parameterGenericPoint familyMap_collapsedFibre

end SchemePropertiesTest.RigidityProjectiveLine
