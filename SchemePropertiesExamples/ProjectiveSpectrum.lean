module

public import Mathlib.Algebra.Field.Rat
import Mathlib.Algebra.MvPolynomial.Division
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
import Mathlib.AlgebraicGeometry.Properties
import Mathlib.RingTheory.Ideal.Maximal
import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import SchemeProperties.PolynomialProjectiveSpace
import SchemeProperties.ProjectiveSpectrum

/-!
# Points on the projective line over the rationals

The total-degree grading on `MvPolynomial (Fin 2) ℚ` has a domain as underlying ring.
Its projective spectrum contains the zero homogeneous prime and the homogeneous prime
generated by `X 1`. The element `X 0` witnesses relevance of both primes, and `X 1`
distinguishes them. The homogeneous ideals and projective spectrum used here are Mathlib's.

The nonemptiness hypothesis in an integrality criterion for a projective spectrum is essential:
a domain concentrated in degree zero has empty projective spectrum.
-/

noncomputable section

open MvPolynomial

namespace AlgebraicGeometry.Proj

attribute [local instance] MvPolynomial.gradedAlgebra

private abbrev projectiveLine : Scheme :=
  Proj (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ)

private theorem coordinateRing_isDomain : IsDomain (MvPolynomial (Fin 2) ℚ) :=
  inferInstance

private theorem coordinateRing_isReduced : _root_.IsReduced (MvPolynomial (Fin 2) ℚ) :=
  inferInstance

private theorem xZero_mem_irrelevant :
    X (0 : Fin 2) ∈
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) :=
  HomogeneousIdeal.mem_irrelevant_of_mem _ Nat.zero_lt_one (MvPolynomial.isHomogeneous_X ℚ _)

private def genericPoint :
    ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) where
  asHomogeneousIdeal := ⊥
  isPrime := by
    rw [HomogeneousIdeal.toIdeal_bot]
    exact Ideal.isPrime_bot
  not_irrelevant_le := by
    intro h
    have hx : X (0 : Fin 2) ∈ (⊥ : Ideal (MvPolynomial (Fin 2) ℚ)) :=
      h xZero_mem_irrelevant
    exact MvPolynomial.X_ne_zero _ (Ideal.mem_bot.mp hx)

private def coordinateIdeal :
    HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) :=
  ⟨Ideal.span {X (1 : Fin 2)}, Ideal.homogeneous_span _ _ (by
    intro f hf
    rcases Set.mem_singleton_iff.mp hf with rfl
    exact ⟨1, MvPolynomial.isHomogeneous_X ℚ (1 : Fin 2)⟩)⟩

private theorem mem_coordinateIdeal (f : MvPolynomial (Fin 2) ℚ) :
    f ∈ coordinateIdeal ↔ X (1 : Fin 2) ∣ f :=
  Ideal.mem_span_singleton

private theorem xZero_not_mem_coordinateIdeal : X (0 : Fin 2) ∉ coordinateIdeal := by
  rw [mem_coordinateIdeal, MvPolynomial.X_dvd_X]
  decide

private theorem coordinateIdeal_isPrime : coordinateIdeal.toIdeal.IsPrime :=
  Ideal.isPrime_span_singleton_of_prime (MvPolynomial.X_prime (R := ℚ) (i := (1 : Fin 2)))

private def rationalLineCoordinatePoint :
    ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) where
  asHomogeneousIdeal := coordinateIdeal
  isPrime := coordinateIdeal_isPrime
  not_irrelevant_le := fun h => xZero_not_mem_coordinateIdeal (h xZero_mem_irrelevant)

private theorem genericPoint_ne_coordinatePoint : genericPoint ≠ rationalLineCoordinatePoint := by
  intro h
  have hI : (⊥ : Ideal (MvPolynomial (Fin 2) ℚ)) = coordinateIdeal.toIdeal :=
    congrArg (fun x : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ) =>
      x.asHomogeneousIdeal.toIdeal) h
  have hx : X (1 : Fin 2) ∈ (⊥ : Ideal (MvPolynomial (Fin 2) ℚ)) := by
    rw [hI]
    exact Ideal.mem_span_singleton_self _
  exact MvPolynomial.X_ne_zero _ (Ideal.mem_bot.mp hx)

/-- The rational projective line has distinct points with homogeneous ideals `(0)`
and `(X 1)`, respectively. -/
public theorem
    _root_.AlgebraicGeometry.PolynomialProjectiveSpace.exists_points_rat_line_with_ideals :
    ∃ η x : PolynomialProjectiveSpace ℚ 1,
      η.asHomogeneousIdeal = ⊥ ∧
      x.asHomogeneousIdeal.toIdeal = Ideal.span {MvPolynomial.X (1 : Fin 2)} ∧
      η ≠ x :=
  ⟨genericPoint, rationalLineCoordinatePoint, rfl, rfl, genericPoint_ne_coordinatePoint⟩

private theorem projectiveLine_nonempty : Nonempty projectiveLine :=
  ⟨genericPoint⟩

private theorem projectiveLine_has_two_points : ∃ x y : projectiveLine, x ≠ y := by
  obtain ⟨η, x, _, _, h⟩ := PolynomialProjectiveSpace.exists_points_rat_line_with_ideals
  exact ⟨η, x, h⟩

private instance projectiveLine_instNonempty : Nonempty projectiveLine :=
  projectiveLine_nonempty

private theorem projectiveLine_isReduced : AlgebraicGeometry.IsReduced projectiveLine := by
  infer_instance

private theorem projectiveLine_preirreducibleSpace : PreirreducibleSpace projectiveLine := by
  infer_instance

private theorem projectiveLine_isIntegral : AlgebraicGeometry.IsIntegral projectiveLine :=
  AlgebraicGeometry.Proj.isIntegral (MvPolynomial.homogeneousSubmodule (Fin 2) ℚ)

end AlgebraicGeometry.Proj
