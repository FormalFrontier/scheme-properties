module

public import Mathlib.Algebra.Category.CommAlgCat.FiniteType
public import Mathlib.CategoryTheory.Category.Preorder
public import Mathlib.CategoryTheory.Limits.Final

/-!
# Finitely generated subalgebras and the range adjunction

For a commutative ring `K` and a commutative `K`-algebra `R`, the finitely generated
subalgebras of `R` form a preorder category. The functor
`FGAlgCat.subalgebraToCostructuredArrow` sends a subalgebra to its inclusion in `R`,
viewed as a costructured arrow from the category `FGAlgCat K`.

`FGAlgCat.rangeFunctor` sends an algebra map with finitely generated domain to its
range. The natural factorization equivalence `FGAlgCat.rangeHomEquiv` makes this
functor left adjoint to the subalgebra-stage functor. Consequently the latter is
final. The unit is the range-corestriction of the given map, which need not be
injective; the counit identifies the range of a subalgebra inclusion with that
subalgebra.

The base ring and algebra carriers have independent universes. The ambient algebra
need not be finitely generated, and neither the given maps nor the coefficient
map are assumed injective. The constructions also apply to zero rings and to
subalgebras generated by the empty set.

## Implementation notes

The constructions use Mathlib's `FGAlgCat`, `ObjectProperty.ι`, algebraic ranges,
subalgebra inclusions and `Functor.toCostructuredArrow`. The categorical comparison
is Mathlib's general image reflection `CategoryTheory.MonoOver.imageForgetAdj`.
Here the factorization equivalence is constructed directly for algebraic ranges,
without choosing categorical images or assuming `HasImages`.

## References

* Mathlib's algebraic range and subalgebra API in
  `Mathlib.Algebra.Algebra.Subalgebra.Basic`.
* Mathlib's image reflection in `Mathlib.CategoryTheory.Subobject.MonoOver` and
  right-adjoint finality in `Mathlib.CategoryTheory.Limits.Final`.
-/

@[expose] public section

universe u v w

namespace AlgHom

variable {K : Type u} {A : Type v} {R : Type w}
  [CommSemiring K] [Semiring A] [Semiring R] [Algebra K A] [Algebra K R]

/-- An algebra map factors uniquely through a subalgebra precisely when its range
is contained in that subalgebra. Uniqueness uses injectivity of the subalgebra
inclusion, not injectivity of the given map. -/
theorem range_le_iff_existsUnique (f : A →ₐ[K] R) (S : Subalgebra K R) :
    f.range ≤ S ↔ ∃! g : A →ₐ[K] S, S.val.comp g = f := by
  constructor
  · intro h
    refine ⟨(Subalgebra.inclusion h).comp f.rangeRestrict, ?_, ?_⟩
    · apply AlgHom.ext
      intro x
      rfl
    · intro g hg
      apply AlgHom.ext
      intro x
      apply Subtype.ext
      exact congrArg (fun k : A →ₐ[K] R => k x) hg
  · rintro ⟨g, hg, _⟩ y hy
    obtain ⟨x, rfl⟩ := f.mem_range.mp hy
    have hx : (g x : R) = f x := congrArg (fun k : A →ₐ[K] R => k x) hg
    exact hx ▸ (g x).property

end AlgHom

open CategoryTheory

namespace FGAlgCat

variable {K : Type u} [CommRing K]

local notation "ι" => ObjectProperty.ι
  (fun A : CommAlgCat K ↦ Algebra.FiniteType K A)

variable (R : CommAlgCat.{v, u} K)

local notation "J" => {S : Subalgebra K R // Subalgebra.FG S}
local notation "Q" => CostructuredArrow ι R

/-- The functor sending a finitely generated subalgebra of `R` to its inherited
`K`-algebra and a containment to the corresponding inclusion. -/
def subalgebraFunctor : J ⥤ FGAlgCat.{v, u} K where
  obj S := ⟨CommAlgCat.of K S.1, (Subalgebra.fg_iff_finiteType S.1).mp S.2⟩
  map a := ObjectProperty.homMk (CommAlgCat.ofHom (Subalgebra.inclusion (leOfHom a)))
  map_id S := by
    apply ObjectProperty.hom_ext
    apply CommAlgCat.hom_ext
    exact Subalgebra.inclusion_self
  map_comp a b := by
    apply ObjectProperty.hom_ext
    apply CommAlgCat.hom_ext
    apply AlgHom.ext
    intro x
    exact Subtype.ext rfl

@[simp]
theorem subalgebraFunctor_obj_obj (S : J) :
    ((subalgebraFunctor R).obj S).obj = CommAlgCat.of K S.1 := rfl

@[simp]
theorem subalgebraFunctor_map_hom_hom {S T : J} (a : S ⟶ T) :
    ((subalgebraFunctor R).map a).hom.hom = Subalgebra.inclusion (leOfHom a) := rfl

/-- The subalgebra-stage functor, with its subtype inclusions as the legs to `R`. -/
def subalgebraToCostructuredArrow : J ⥤ Q :=
  (subalgebraFunctor R).toCostructuredArrow ι R
    (fun S => CommAlgCat.ofHom S.1.val) (by
      intro S T a
      apply CommAlgCat.hom_ext
      exact Subalgebra.val_comp_inclusion (leOfHom a))

@[simp]
theorem subalgebraToCostructuredArrow_obj_left (S : J) :
    ((subalgebraToCostructuredArrow R).obj S).left = (subalgebraFunctor R).obj S := rfl

@[simp]
theorem subalgebraToCostructuredArrow_obj_hom (S : J) :
    ((subalgebraToCostructuredArrow R).obj S).hom = CommAlgCat.ofHom S.1.val := rfl

/-- The leg of a subalgebra stage is its algebra-hom inclusion. -/
@[simp]
theorem subalgebraToCostructuredArrow_obj_hom_hom (S : J) :
    ((subalgebraToCostructuredArrow R).obj S).hom.hom = S.1.val := rfl

@[simp]
theorem subalgebraToCostructuredArrow_map_left_hom_hom {S T : J} (a : S ⟶ T) :
    ((subalgebraToCostructuredArrow R).map a).left.hom.hom =
      Subalgebra.inclusion (leOfHom a) := rfl

/-- Projecting a subalgebra stage recovers its finitely generated algebra. -/
theorem subalgebraToCostructuredArrow_comp_proj :
    subalgebraToCostructuredArrow R ⋙ CostructuredArrow.proj ι R = subalgebraFunctor R := rfl

/-- The range of a map from a finitely generated algebra is finitely generated. -/
theorem range_fg (X : Q) : X.hom.hom.range.FG := by
  have : Algebra.FiniteType K ((ι).obj X.left) := X.left.property
  exact (Subalgebra.fg_iff_finiteType _).mpr
    (Algebra.FiniteType.of_surjective X.hom.hom.rangeRestrict
      X.hom.hom.rangeRestrict_surjective)

/-- A commuting morphism of costructured arrows induces containment of ranges. -/
theorem range_le_range {X Y : Q} (a : X ⟶ Y) :
    X.hom.hom.range ≤ Y.hom.hom.range := by
  have hw : Y.hom.hom.comp a.left.hom.hom = X.hom.hom :=
    congrArg CommAlgCat.Hom.hom (CostructuredArrow.w a)
  rw [← hw]
  exact AlgHom.range_comp_le_range _ _

/-- The range functor from maps with finitely generated domain to finitely generated
subalgebras of `R`. Its action on morphisms is induced by their commuting triangles. -/
def rangeFunctor : Q ⥤ J where
  obj X := ⟨X.hom.hom.range, range_fg R X⟩
  map a := homOfLE (range_le_range R a)
  map_id _ := Subsingleton.elim _ _
  map_comp _ _ := Subsingleton.elim _ _

@[simp]
theorem rangeFunctor_obj_val (X : Q) :
    ((rangeFunctor R).obj X).val = X.hom.hom.range := rfl

@[simp]
theorem rangeFunctor_map {X Y : Q} (a : X ⟶ Y) :
    (rangeFunctor R).map a = homOfLE (range_le_range R a) := rfl

/-- Factorizations of a fixed algebra map through a subalgebra stage are unique. -/
theorem hom_to_subalgebra_ext (X : Q) (S : J)
    (a b : X ⟶ (subalgebraToCostructuredArrow R).obj S) : a = b := by
  have hr : X.hom.hom.range ≤ S.1 := by
    have h := range_le_range R a
    rw [subalgebraToCostructuredArrow_obj_hom_hom] at h
    exact h.trans (Subalgebra.range_val S.1).le
  obtain ⟨g, _, huniq⟩ := (AlgHom.range_le_iff_existsUnique X.hom.hom S.1).mp hr
  have ha : S.1.val.comp a.left.hom.hom = X.hom.hom :=
    congrArg CommAlgCat.Hom.hom (CostructuredArrow.w a)
  have hb : S.1.val.comp b.left.hom.hom = X.hom.hom :=
    congrArg CommAlgCat.Hom.hom (CostructuredArrow.w b)
  apply CostructuredArrow.hom_ext
  apply ObjectProperty.hom_ext
  apply CommAlgCat.hom_ext
  exact (huniq _ ha).trans (huniq _ hb).symm

/-- The natural factorization equivalence: range containment corresponds to the
unique factorization through a subalgebra stage. The forward map is inclusion
composed with range-corestriction. -/
def rangeHomEquiv (X : Q) (S : J) :
    ((rangeFunctor R).obj X ⟶ S) ≃
      (X ⟶ (subalgebraToCostructuredArrow R).obj S) where
  toFun h := CostructuredArrow.homMk
    (ObjectProperty.homMk (CommAlgCat.ofHom
      ((Subalgebra.inclusion (leOfHom h)).comp X.hom.hom.rangeRestrict))) (by
        apply CommAlgCat.hom_ext
        apply AlgHom.ext
        intro x
        rfl)
  invFun a := homOfLE (by
    change X.hom.hom.range ≤ S.1
    have h := range_le_range R a
    rw [subalgebraToCostructuredArrow_obj_hom_hom] at h
    exact h.trans (Subalgebra.range_val S.1).le)
  left_inv _ := Subsingleton.elim _ _
  right_inv a := hom_to_subalgebra_ext R X S _ a

@[simp]
theorem rangeHomEquiv_apply_left_hom_hom
    (X : Q) (S : J) (h : (rangeFunctor R).obj X ⟶ S) :
    (rangeHomEquiv R X S h).left.hom.hom =
      (Subalgebra.inclusion (leOfHom h)).comp X.hom.hom.rangeRestrict := rfl

/-- The factorization has the same ambient values as the original map. -/
theorem rangeHomEquiv_apply_coe
    (X : Q) (S : J) (h : (rangeFunctor R).obj X ⟶ S) (b : X.left.obj) :
    S.1.val ((rangeHomEquiv R X S h).left.hom.hom b) = X.hom.hom b := rfl

/-- The factorization equivalence is natural in the costructured arrow. -/
theorem rangeHomEquiv_naturality_left
    {X' X : Q} (a : X' ⟶ X) (S : J)
    (h : (rangeFunctor R).obj X ⟶ S) :
    rangeHomEquiv R X' S ((rangeFunctor R).map a ≫ h) =
      a ≫ rangeHomEquiv R X S h :=
  hom_to_subalgebra_ext R X' S _ _

/-- The factorization equivalence is natural in the subalgebra stage. -/
theorem rangeHomEquiv_naturality_right
    (X : Q) {S T : J} (h : (rangeFunctor R).obj X ⟶ S) (a : S ⟶ T) :
    rangeHomEquiv R X T (h ≫ a) =
      rangeHomEquiv R X S h ≫ (subalgebraToCostructuredArrow R).map a :=
  hom_to_subalgebra_ext R X T _ _

/-- The range functor is left adjoint to the subalgebra-stage functor. -/
def rangeAdjunction : rangeFunctor R ⊣ subalgebraToCostructuredArrow R :=
  Adjunction.mkOfHomEquiv
    { homEquiv := rangeHomEquiv R
      homEquiv_naturality_left_symm := fun _ _ => Subsingleton.elim _ _
      homEquiv_naturality_right := fun h a => rangeHomEquiv_naturality_right R _ h a }

/-- The subalgebra-stage functor is a right adjoint, with the range functor as its
left adjoint. -/
instance subalgebraToCostructuredArrow_isRightAdjoint :
    (subalgebraToCostructuredArrow R).IsRightAdjoint :=
  ⟨⟨rangeFunctor R, ⟨rangeAdjunction R⟩⟩⟩

/-- The subalgebra-stage functor is final because it is a right adjoint. -/
instance subalgebraToCostructuredArrow_final :
    (subalgebraToCostructuredArrow R).Final :=
  Functor.final_of_adjunction (rangeAdjunction R)

/-- Taking the range of a subalgebra inclusion recovers the same subalgebra stage. -/
@[simp]
theorem rangeFunctor_subalgebraToCostructuredArrow_obj (S : J) :
    (rangeFunctor R).obj ((subalgebraToCostructuredArrow R).obj S) = S := by
  apply Subtype.ext
  exact Subalgebra.range_val S.1

@[simp]
theorem rangeAdjunction_homEquiv (X : Q) (S : J) :
    (rangeAdjunction R).homEquiv X S = rangeHomEquiv R X S := by
  simp only [rangeAdjunction, Adjunction.mkOfHomEquiv_homEquiv]

/-- The adjunction unit is the range-corestriction of the original map. -/
@[simp]
theorem rangeAdjunction_unit_app_left_hom_hom (X : Q) :
    ((rangeAdjunction R).unit.app X).left.hom.hom = X.hom.hom.rangeRestrict := by
  rw [← Adjunction.homEquiv_id, rangeAdjunction_homEquiv,
    rangeHomEquiv_apply_left_hom_hom]
  apply AlgHom.ext
  intro x
  exact Subtype.ext rfl

/-- The adjunction counit is the order arrow given by the range of the stage's
subtype inclusion. -/
@[simp]
theorem rangeAdjunction_counit_app (S : J) :
    (rangeAdjunction R).counit.app S =
      eqToHom (rangeFunctor_subalgebraToCostructuredArrow_obj R S) :=
  Subsingleton.elim _ _

end FGAlgCat
