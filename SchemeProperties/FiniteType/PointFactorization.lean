module

public import Mathlib.AlgebraicGeometry.Group.Affine
public import Mathlib.AlgebraicGeometry.Gluing
public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType

/-!
# Factorization through monomorphisms on finite-type points

A morphism from a scheme locally of finite type over a commutative ring factors through a
monomorphism if and only if all its points valued in finitely generated algebras factor through
that monomorphism. The schemes defining the monomorphism need not satisfy any finiteness
condition.

The proof uses the universal points of an affine open cover of the source. Their coefficient
algebras are finitely generated by the source's local finite-type hypothesis. Monicity gives
agreement on overlaps, and Mathlib's `Scheme.Cover.glueMorphisms` glues the local factors.

## Main results

- `AlgebraicGeometry.Scheme.exists_lift_iff_forall_finiteType`

## References

- Mathlib's affine open covers, finite-type spectrum criterion and gluing of scheme morphisms,
  in `Mathlib.AlgebraicGeometry.Cover.Open`,
  `Mathlib.AlgebraicGeometry.Morphisms.FiniteType` and `Mathlib.AlgebraicGeometry.Gluing`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

/-- A morphism with source locally of finite type over a commutative ring factors through a
monomorphism exactly when its points over every finitely generated algebra do. No finiteness
condition is imposed on either scheme defining the monomorphism. -/
theorem Scheme.exists_lift_iff_forall_finiteType
    (K : Type u) [CommRing K]
    {X Y N : Over (Spec (.of K))} [LocallyOfFiniteType X.hom]
    (i : N ⟶ Y) [Mono i] (f : X ⟶ Y) :
    (∃ l : X ⟶ N, l ≫ i = f) ↔
      ∀ (R : CommAlgCat.{u, u} K), Algebra.FiniteType K R →
        ∀ (p : (algSpec (.of K)).obj (op R) ⟶ X),
          ∃ q : (algSpec (.of K)).obj (op R) ⟶ N, q ≫ i = p ≫ f := by
  classical
  constructor
  · rintro ⟨l, hl⟩ R _ p
    exact ⟨p ≫ l, by rw [Category.assoc, hl]⟩
  · intro h
    let 𝒰 := X.left.affineOpenCover
    have hlocal : ∀ j, ∃ v : Spec (𝒰.X j) ⟶ N.left,
        v ≫ i.left = 𝒰.f j ≫ f.left := by
      intro j
      let φ := Spec.preimage (𝒰.f j ≫ X.hom)
      let _ : Algebra K (𝒰.X j) := φ.hom.toAlgebra
      have hφ : RingHom.FiniteType φ.hom := by
        apply (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp
        simpa only [φ, Spec.map_preimage] using
          (inferInstance : LocallyOfFiniteType (𝒰.f j ≫ X.hom))
      have hft : Algebra.FiniteType K (𝒰.X j) := by
        rw [← RingHom.finiteType_algebraMap]
        exact hφ
      let R : CommAlgCat.{u, u} K := .of K (𝒰.X j)
      let p : (algSpec (.of K)).obj (op R) ⟶ X := Over.homMk (𝒰.f j) (by
        rw [algSpec_obj_hom]
        change 𝒰.f j ≫ X.hom = Spec.map φ
        exact (Spec.map_preimage _).symm)
      obtain ⟨q, hq⟩ := h R hft p
      exact ⟨q.left, congrArg (fun g => g.left) hq⟩
    choose v hv using hlocal
    have hoverlap : ∀ j k,
        pullback.fst (𝒰.f j) (𝒰.f k) ≫ v j =
          pullback.snd (𝒰.f j) (𝒰.f k) ≫ v k := by
      intro j k
      apply (cancel_mono i.left).mp
      simp only [Category.assoc, hv, pullback.condition_assoc]
    let l₀ : X.left ⟶ N.left := 𝒰.openCover.glueMorphisms v hoverlap
    have hl₀ : l₀ ≫ i.left = f.left := by
      apply 𝒰.openCover.hom_ext
      intro j
      rw [← Category.assoc]
      exact (congrArg (· ≫ i.left)
        (𝒰.openCover.ι_glueMorphisms v hoverlap j)).trans (hv j)
    refine ⟨Over.homMk l₀ ?_, ?_⟩
    · rw [← i.w, ← Category.assoc, hl₀, f.w]
    · apply Over.OverMorphism.ext
      exact hl₀

end AlgebraicGeometry
